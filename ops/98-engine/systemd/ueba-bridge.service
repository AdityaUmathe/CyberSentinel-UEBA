[Unit]
Description=CyberSentinel UEBA Feed Bridge (222 -> 98 enriched sync over tunnel)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/root/NEW_DRIVE/aditya_ueba

[Service]
Type=simple
User=root
WorkingDirectory=/root/NEW_DRIVE/aditya_ueba
ExecStart=/root/NEW_DRIVE/aditya_ueba/ueba_sync_bridge.sh
# The reverse tunnel lives on 222 (its own autossh systemd unit) and may not be
# up yet when 98 boots. The bridge script self-retries on a missing tunnel
# ("No enriched files found — retrying in 30s"); Restart=always covers an exit.
Restart=always
RestartSec=10
TimeoutStopSec=20
StandardOutput=append:/root/NEW_DRIVE/aditya_ueba/logs/ueba_bridge.stdout.log
StandardError=append:/root/NEW_DRIVE/aditya_ueba/logs/ueba_bridge.stdout.log

[Install]
WantedBy=multi-user.target
