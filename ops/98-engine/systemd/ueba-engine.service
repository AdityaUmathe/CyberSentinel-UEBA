[Unit]
Description=CyberSentinel UEBA Streaming Engine
After=network-online.target
Wants=network-online.target
# Don't start before the data volume(s) are mounted (engine reads enriched.jsonl
# and loads models/FAISS from these paths).
RequiresMountsFor=/root/NEW_DRIVE/aditya_ueba /data/aditya_ueba

[Service]
Type=simple
User=root
WorkingDirectory=/root/NEW_DRIVE/aditya_ueba
ExecStart=/root/NEW_DRIVE/aditya_ueba/venv/bin/python3 ueba_engine.py
# Restart=always covers two cases: a crash, and starting too early at boot before
# the GPU/CUDA driver is ready (the engine exits, systemd retries until it sticks).
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/root/NEW_DRIVE/aditya_ueba/logs/ueba_engine.stdout.log
StandardError=append:/root/NEW_DRIVE/aditya_ueba/logs/ueba_engine.stdout.log

[Install]
WantedBy=multi-user.target
